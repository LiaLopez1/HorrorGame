      m_Calls: []
  m_text: "En Black Hollow, el silencio es tu \xFAnica arma.\nAqu\xED, el m\xE1s
    leve susurro puede sellar tu destino.\nEvita hablar, respirar fuerte o generar
    ruido\u2026 porque ellos escuchan.\nEste juego detecta tu voz en tiempo real
    a trav\xE9s del micr\xF3fono.\nSin micr\xF3fono, no podr\xE1s jugar. No es solo
    parte de la experiencia\u2026 es parte de la supervivencia.\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 18884daf5cc1e0c41ad810abbf6653db, type: 2}
